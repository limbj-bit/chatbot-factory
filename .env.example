# Application
APP_ENV=development
APP_NAME="Fresh Food Claim AI SaaS"
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./data/claims.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/fresh_claims
REDIS_URL=redis://localhost:6379/0

# Mock Mode Configuration (Set true for local running without paid external API keys)
MOCK_AI=true
MOCK_CAFE24=true

# AI Providers
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
# OpenRouter (텍스트·이미지 상위 모델 풀 — 한 키로 여러 모델 RR)
OPENROUTER_API_KEY=

# Text: rotate free (groq/nvidia/openrouter/mistral) → gemini last
# Vision: nvidia VL pool → openrouter VL pool → gemini last
AI_DEFAULT_PROVIDER=groq
AI_FALLBACK_PROVIDER=nvidia
AI_VISION_PROVIDER=nvidia
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
# Comma pools rotate per request; next model on 404/429
NVIDIA_TEXT_MODELS=nvidia/llama-3.3-nemotron-super-49b-v1.5,meta/llama-3.3-70b-instruct
NVIDIA_TEXT_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
NVIDIA_VISION_MODELS=meta/llama-3.2-90b-vision-instruct,meta/llama-3.2-11b-vision-instruct
NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
MISTRAL_TEXT_MODEL=mistral-large-latest
OPENROUTER_TEXT_MODELS=qwen/qwen-2.5-72b-instruct,deepseek/deepseek-chat,meta-llama/llama-3.3-70b-instruct
OPENROUTER_TEXT_MODEL=qwen/qwen-2.5-72b-instruct
OPENROUTER_VISION_MODELS=nvidia/nemotron-3.5-super-vl:free,meta-llama/llama-3.2-11b-vision-instruct,openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=nvidia/nemotron-3.5-super-vl:free
GEMINI_TEXT_MODEL=gemini-2.0-flash

# Cafe24 Integration
CAFE24_MALL_ID=demo_mall
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_ACCESS_TOKEN=
CAFE24_API_VERSION=2024-06-01

# Refund Policy Thresholds (Configurable Business Rules)
POLICY_FULL_REFUND_DAMAGE_RATIO=30
POLICY_PARTIAL_REFUND_DAMAGE_RATIO=10
POLICY_MAX_CLAIM_DAYS=2
POLICY_MIN_VISION_CONFIDENCE=0.70

# Security & Uploads
CLAIM_IMAGE_MAX_SIZE_MB=10
ADMIN_API_KEY=admin-dev-secret-key-change-in-prod
UPLOAD_DIR=./uploads

# Commerce OAuth Secret/Token encryption key (Fernet, 32-byte url-safe base64)
# 없으면 카페24 연동(키 저장/주문조회) 자체가 차단됩니다.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
