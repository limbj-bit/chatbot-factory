# Application
APP_ENV=development
APP_NAME="Fresh Food Claim AI SaaS"
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# Database & Cache
DATABASE_URL=sqlite+aiosqlite:///./data/claims.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost:5432/fresh_claims
REDIS_URL=redis://localhost:6379/0

# Mock Mode Configuration (Set true for local running without paid external API keys)
MOCK_AI=true
MOCK_CAFE24=true

# AI Providers
GROQ_API_KEY=
NVIDIA_API_KEY=
GEMINI_API_KEY=
# OpenRouter (이미지 판독 백업 — GPT-4o/Claude/Gemini/Qwen-VL 등 여러 비전 모델을 한 키로)
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# Text: groq → nvidia → openrouter → mistral → gemini(last paid)
# Vision: nvidia → openrouter → gemini(last paid)
AI_DEFAULT_PROVIDER=groq
AI_FALLBACK_PROVIDER=nvidia
AI_VISION_PROVIDER=nvidia

# Cafe24 Integration
CAFE24_MALL_ID=demo_mall
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
CAFE24_ACCESS_TOKEN=
CAFE24_API_VERSION=2024-06-01

# Refund Policy Thresholds (Configurable Business Rules)
POLICY_FULL_REFUND_DAMAGE_RATIO=30
POLICY_PARTIAL_REFUND_DAMAGE_RATIO=10
POLICY_MAX_CLAIM_DAYS=2
POLICY_MIN_VISION_CONFIDENCE=0.70

# Security & Uploads
CLAIM_IMAGE_MAX_SIZE_MB=10
ADMIN_API_KEY=admin-dev-secret-key-change-in-prod
UPLOAD_DIR=./uploads

# Commerce OAuth Secret/Token encryption key (Fernet, 32-byte url-safe base64)
# 없으면 카페24 연동(키 저장/주문조회) 자체가 차단됩니다.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
